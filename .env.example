# PostgreSQL: use a senha ATUAL do banco. Alterar este valor não altera a senha de um volume já inicializado.
POSTGRES_PASSWORD=troque_por_uma_senha_forte_do_postgres

# JWT: gere uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET_KEY=troque_por_uma_chave_aleatoria_com_mais_de_32_caracteres

# URL pública final do AutoNexus, sem barra no final.
APPLICATION_URL=https://app.seudominio.com.br

# Mercado Pago produção (obrigatório para checkout e webhooks).
MERCADOPAGO_ACCESS_TOKEN=APP_USR-coloque_seu_access_token_de_producao
MERCADOPAGO_WEBHOOK_SECRET=coloque_o_segredo_do_webhook_do_painel

# Resend (opcional; sem essas variáveis, e-mails não serão enviados).
RESEND_API_KEY=re_coloque_sua_api_key
RESEND_FROM_EMAIL=nao-responder@seudominio.com.br
RESEND_FROM_NAME=AutoNexus

# Contas de bootstrap de produção. Use credenciais fortes e guarde-as em local seguro.
# As contas só são criadas se ainda não existir usuário com o e-mail informado.
AUTONEXUS_INITIAL_ADMIN_EMAIL=admin@seudominio.com.br
AUTONEXUS_INITIAL_ADMIN_PASSWORD=coloque_uma_senha_forte_unica
AUTONEXUS_SUPERADMIN_EMAIL=superadmin@seudominio.com.br
AUTONEXUS_SUPERADMIN_PASSWORD=coloque_outra_senha_forte_unica
