version: '3.8'

services:
  postgres:
    image: postgres:16-alpine
    container_name: autonexus-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: autonexus
      POSTGRES_USER: autonexus
      POSTGRES_PASSWORD: AutoNexus@2025!
    ports:
      - "5433:5433"
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data: